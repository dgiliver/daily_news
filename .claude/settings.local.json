{
  "permissions": {
    "allow": [
      "Bash(cat:*)",
      "Bash(pip install:*)",
      "Bash(python:*)",
      "Bash(pytest:*)",
      "Bash(git pull:*)",
      "Bash(git push:*)",
      "Bash(detect-secrets scan:*)",
      "Bash(ruff check:*)",
      "Bash(ruff format:*)",
      "Bash(pre-commit install)",
      "Bash(pre-commit install:*)",
      "Bash(pre-commit run:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(gh run list:*)",
      "Bash(ls:*)",
      "Bash(git stash:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(curl:*)",
      "Bash(pip list:*)",
      "Bash(pip show:*)"
    ]
  },
  "hooks": {
    "postToolUse": [
      {
        "event": "Edit",
        "matcher": "**/*.py",
        "command": "cd /Users/dgiliver/personal_projects/daily_news && ruff format $FILE && ruff check --fix $FILE 2>/dev/null || true"
      }
    ]
  }
}
